{
  "name": "@obsidian-ui-system/capture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "check": "tsc --noEmit",
    "test:typography": "esbuild tests/typography-capture.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/typography-capture.test.cjs && node --test ../../.build/typography-capture.test.cjs"
  },
  "dependencies": {
    "@obsidian-ui-system/ui-schema": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "^0.25.5",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
