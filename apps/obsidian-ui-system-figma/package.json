{
  "name": "@obsidian-ui-system/figma-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run check && esbuild src/code.ts --bundle --platform=browser --target=es2017 --outfile=dist/code.js",
    "check": "tsc --noEmit",
    "test:font": "esbuild tests/font-resolution.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/font-resolution.test.cjs && node --test ../../.build/font-resolution.test.cjs",
    "test:search": "esbuild tests/search-data.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/search-data.test.cjs && node --test ../../.build/search-data.test.cjs",
    "test:file-explorer-row": "esbuild tests/file-explorer-row-data.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/file-explorer-row-data.test.cjs && node --test ../../.build/file-explorer-row-data.test.cjs",
    "test:folder-row": "esbuild tests/folder-row-data.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/folder-row-data.test.cjs && node --test ../../.build/folder-row-data.test.cjs",
    "test:tree-row": "esbuild tests/tree-navigation-row-data.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/tree-navigation-row-data.test.cjs && node --test ../../.build/tree-navigation-row-data.test.cjs",
    "test:tree-guides": "esbuild tests/tree-navigation-guides.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/tree-navigation-guides.test.cjs && node --test ../../.build/tree-navigation-guides.test.cjs",
    "test:primitive-theme": "esbuild tests/primitive-theme.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/primitive-theme.test.cjs && node --test ../../.build/primitive-theme.test.cjs",
    "test:appearance-lifecycle": "esbuild tests/appearance-lifecycle.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/appearance-lifecycle.test.cjs && node --test ../../.build/appearance-lifecycle.test.cjs",
    "test:ui-kit-node-lifecycle": "esbuild tests/ui-kit-node-lifecycle.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/ui-kit-node-lifecycle.test.cjs && node --test ../../.build/ui-kit-node-lifecycle.test.cjs",
    "test:public-controls": "esbuild tests/public-controls-data.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/public-controls-data.test.cjs && node --test ../../.build/public-controls-data.test.cjs",
    "test:glyph-library": "esbuild tests/glyph-library.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/glyph-library.test.cjs && node --test ../../.build/glyph-library.test.cjs",
    "test:ui-kit-theme": "esbuild tests/ui-kit-theme.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/ui-kit-theme.test.cjs && node --test ../../.build/ui-kit-theme.test.cjs",
    "test:view-header": "esbuild tests/view-header-data.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/view-header-data.test.cjs && node --test ../../.build/view-header-data.test.cjs",
    "test:workspace-tab": "esbuild tests/workspace-tab-data.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/workspace-tab-data.test.cjs && node --test ../../.build/workspace-tab-data.test.cjs",
    "test:side-panel": "esbuild tests/side-panel-data.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/side-panel-data.test.cjs && node --test ../../.build/side-panel-data.test.cjs",
    "test:search-view": "esbuild tests/search-view-data.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/search-view-data.test.cjs && node --test ../../.build/search-view-data.test.cjs",
    "test:ui-kit": "esbuild tests/ui-kit-layout.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/ui-kit-layout.test.cjs && node --test ../../.build/ui-kit-layout.test.cjs",
    "test:full-ui-kit": "esbuild tests/full-ui-kit-data.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/full-ui-kit-data.test.cjs && node --test ../../.build/full-ui-kit-data.test.cjs",
    "test:file-explorer-view": "esbuild tests/file-explorer-view-data.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/file-explorer-view-data.test.cjs && node --test ../../.build/file-explorer-view-data.test.cjs",
    "test:bookmarks-view": "esbuild tests/bookmarks-view-data.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/bookmarks-view-data.test.cjs && node --test ../../.build/bookmarks-view-data.test.cjs",
    "test:package": "esbuild tests/package-data.test.ts --bundle --platform=node --format=cjs --outfile=../../.build/figma-package-data.test.cjs && node --test ../../.build/figma-package-data.test.cjs",
    "test:variables": "esbuild tests/variable-projection.test.ts tests/button-binding-evidence.test.ts tests/button-normal-binding.test.ts --bundle --platform=node --format=cjs --outdir=../../.build/variable-tests && node --test ../../.build/variable-tests/variable-projection.test.js ../../.build/variable-tests/button-binding-evidence.test.js ../../.build/variable-tests/button-normal-binding.test.js",
    "dev": "esbuild src/code.ts --bundle --platform=browser --target=es2017 --outfile=dist/code.js --watch"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.140.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  }
}
