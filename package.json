{
  "name": "obsidian-ui-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @obsidian-ui-system/capture && npm run build --workspace @obsidian-ui-system/figma-plugin && npm run build:diff",
    "build:diff": "tsc --project scripts/tsconfig.json",
    "dev": "npm run dev --workspace @obsidian-ui-system/capture",
    "check": "npm run check --workspace @obsidian-ui-system/capture && npm run check --workspace @obsidian-ui-system/figma-plugin && tsc --noEmit --project scripts/tsconfig.json",
    "test:diff": "npm run build:diff && node --test .build/snapshot-diff/snapshot-diff.test.js",
    "test:layout": "esbuild apps/obsidian-ui-atlas/src/layout-inference.test.ts --bundle --platform=node --format=cjs --outfile=.build/layout-inference.test.cjs && node --test .build/layout-inference.test.cjs",
    "diff:snapshots": "npm run build:diff && node .build/snapshot-diff/diff-snapshots.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
